[Unit]
Description=Microclimate Display Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/root/microclimate
ExecStart=/home/root/microclimate/.venv/bin/python /home/root/microclimate/src/display_monitor.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY_INTERVAL_SECONDS=3

[Install]
WantedBy=multi-user.target
