[Unit]
Description=Microclimate CSV Data Logger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/root/microclimate
ExecStart=/home/root/microclimate/.venv/bin/python /home/root/microclimate/src/data_logger.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=LOGGER_INTERVAL_SECONDS=10
Environment=MICROCLIMATE_CSV_LOG=data/microclimate.csv

[Install]
WantedBy=multi-user.target
