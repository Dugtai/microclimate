# Telegram Bot API token
BOT_TOKEN=put_telegram_bot_token_here

# VK group/community API token
VK_TOKEN=put_vk_group_token_here

# Comma-separated trusted account identifiers. Keep real values only in .env.
TELEGRAM_ALLOWED_USER_IDS=
VK_ALLOWED_USER_IDS=

# Optional: path to sensor configuration
SENSOR_CONFIG_PATH=./config/sensors.json

# Optional HTTPS telemetry endpoint and bearer credential
METRICS_ENDPOINT=https://monitoring.example.invalid/api/v1/microclimate
METRICS_BEARER_TOKEN=put_random_telemetry_token_here
METRICS_INTERVAL_SECONDS=60
